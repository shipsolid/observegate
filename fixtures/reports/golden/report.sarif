{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Observability Gate",
          "rules": [
            {
              "id": "policy.sarif"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "policy.sarif",
          "level": "warning",
          "message": {
            "text": "Unsafe instrumentation setting"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/telemetry.ts"
                },
                "region": {
                  "startLine": 12,
                  "startColumn": 3
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
