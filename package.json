{
  "name": "observability-gate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:e2e": "vitest run tests/end-to-end tests/integration tests/failure-injection",
    "test:security": "vitest run tests/security",
    "test:property": "vitest run tests/property",
    "test:mutation": "stryker run",
    "test:performance": "vitest run tests/performance --pool=forks --isolate",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:generate": "npm run build && node --experimental-strip-types scripts/generate-docs.ts",
    "bundle": "tsc -b && rollup -c rollup.config.js",
    "verify:bundle": "node --experimental-strip-types scripts/verify-bundle.ts",
    "verify:read-only": "node --experimental-strip-types scripts/verify-read-only.ts",
    "verify:reproducible": "node --experimental-strip-types scripts/verify-reproducible-build.ts",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.12.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.9",
    "rollup": "4.64.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "4.1.11"
  }
}
